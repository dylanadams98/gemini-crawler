# Required: free key from https://serpapi.com/manage-api-key (250 searches/month on the free plan)
SERPAPI_KEY=

# Timezone + local hour the daily crawl runs at
TZ=Europe/London
CRAWL_HOUR=6

# Google search locale (defaults: uk / en)
SERPAPI_GL=uk
SERPAPI_HL=en
# SERPAPI_GOOGLE_DOMAIN=google.co.uk
# SERPAPI_LOCATION=London,England,United Kingdom

# Optional: protect the UI with basic auth (user:password)
# BASIC_AUTH=admin:change-me

# Host port for docker-compose
# HOST_PORT=3000
